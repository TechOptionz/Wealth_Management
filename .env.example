# Holdfast — environment template. Copy to .env.local
NEXT_PUBLIC_APP_NAME="Holdfast"

# Reporting currency and locale used for all money formatting (BR-03 presentation)
NEXT_PUBLIC_BASE_CURRENCY="AUD"
# Must be a locale tag Intl accepts (en-AU, en-US, en-GB). Blank, quoted-in-a-dashboard,
# or malformed values (en_AU) fall back to en-AU instead of failing the build.
NEXT_PUBLIC_LOCALE="en-AU"

# The "as of" date the read models are evaluated against.
# Leave unset in production to use the current date; pin it to reproduce the design prototype.
AS_OF_DATE="2026-09-06"

# Data adapter: "memory" (seeded in-process store) | "postgres" (not yet implemented)
DATA_ADAPTER="memory"
