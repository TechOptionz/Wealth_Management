# Holdfast — environment template. Copy to .env.local

NEXT_PUBLIC_APP_NAME="Holdfast"

# Reporting currency and locale used for all money formatting (BR-03 presentation)
NEXT_PUBLIC_BASE_CURRENCY="AUD"
NEXT_PUBLIC_LOCALE="en-AU"

# The "as of" date the read models are evaluated against.
# Leave unset in production to use the current date; pin it to reproduce the design prototype.
AS_OF_DATE="2026-09-06"

# Where data lives.
#
# Set DATABASE_URL to a Postgres connection string and the app stores every
# record there, creating its two tables and seeding the sample data on first
# use. Supabase, Neon, Vercel Postgres and a local Postgres all work.
# POSTGRES_URL is accepted as an alias, which is the name Vercel integrations set.
#
# Supabase: in the dashboard choose Connect and copy the "Transaction pooler"
# string (port 6543). The "Direct connection" string is IPv6-only on most
# plans and cannot be reached from Vercel. Replace [YOUR-PASSWORD] with the
# database password, URL-encoding any special characters in it.
#
# Encryption: a local host connects in the clear; any other host is encrypted.
# The server certificate is accepted unverified unless DATABASE_CA_CERT holds
# the PEM certificate your provider publishes, or the URL sets an explicit
# sslmode such as "?sslmode=verify-full".
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
#
# Leave it unset and the app runs on the seeded in-memory store, which resets
# whenever the server restarts.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Optional override: "memory" | "postgres". Unset means "postgres when
# DATABASE_URL is set, otherwise memory". Set "memory" to run on sample data
# locally while keeping a DATABASE_URL in the file for `npm run db:reset`.
# DATA_ADAPTER="memory"

# Development Finance
#
# Secret used to sign expiring report download links. Unset means a random
# per-process secret: links then stop working after a restart, which is safe.
# REPORT_LINK_SECRET="a-long-random-string"
#
# Turn the read-only project Assistant off for this organisation (AI07).
# No language-model provider is connected in this build either way.
# ASSISTANT_DISABLED="true"
